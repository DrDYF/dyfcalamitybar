{
	"schemaVersion": 1,
	"id": "dyfcalamitybar",
	"version": "${version}",
	"name": "DYFCalamityBar",
	"description": "Adds the Terraria Calamity Rage Mode and Adrenaline mechanics: rage fills near enemies (+35% damage when full), adrenaline charges during boss fights while undamaged (halves a full-bar hit and grants +150% damage when activated).",
	"authors": [
		"DYF"
	],
	"contact": {
		"homepage": "https://github.com/",
		"sources": "https://github.com/"
	},
	"license": "MIT",
	"icon": "assets/dyfcalamitybar/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.dyf.calamitybar.DYFCalamityBar"
		],
		"client": [
			"com.dyf.calamitybar.DYFCalamityBarClient"
		],
		"fabric-datagen": [
			"com.dyf.calamitybar.DYFCalamityBarDataGenerator"
		]
	},
	"mixins": [
		"dyfcalamitybar.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}
